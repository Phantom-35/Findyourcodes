# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# Die Web-App UND der Worker lesen beide .env.local.

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Nur für den Worker! Niemals in Vercel/öffentlich eintragen.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Nur für den Worker ---
YOUTUBE_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: günstigeres Modell, z.B. claude-haiku-5-5 (Standard: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Wie viele neueste Videos pro Kanal geprüft werden (Standard 10)
# VIDEOS_PER_CHANNEL=10

# --- Video-Analyse (Transkript + Einblendungen) – nur auf deinem eigenen PC ---
# Braucht yt-dlp, ffmpeg und deno (siehe SETUP.md)
ENABLE_VIDEO_ANALYSIS=false
# VIDEO_ANALYSIS_LIMIT=20
# VIDEO_ANALYSIS_MAX_AGE_DAYS=30
# MAX_FRAMES_PER_VIDEO=16
# RETRY_FAILED_VIDEOS=false
# Falls YouTube trotzdem "Sign in to confirm you're not a bot" meldet:
# YTDLP_EXTRA_ARGS=--cookies-from-browser firefox
